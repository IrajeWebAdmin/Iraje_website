// Prisma schema for the Iraje marketing site.
// Docs: https://pris.ly/d/prisma-schema
//
// This model maps to the EXISTING `contact_message` table in the
// `iraje_website` database. Column types/nullability mirror that table so
// `npx prisma db push` only ADDS the new `status` column (used for tracking
// submissions later) and never drops or rewrites existing data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A single "Contact Us" form submission.
/// `status` lets submissions be triaged/tracked later (new -> contacted -> closed).
model Contact {
  id        Int       @id @default(autoincrement())
  name      String?   @db.VarChar(100)
  contactNo String?   @map("contact_no") @db.VarChar(20)
  email     String?   @db.VarChar(255)
  message   String?   @db.Text
  status    String    @default("new") @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("contact_message")
}

/// A certification enrolment request from the Certification page form.
/// Unlike Contact (which mirrors a pre-existing table), this table is created
/// by Prisma, so the columns the form marks required are NOT NULL here.
/// `status` mirrors Contact's, for triage: new -> approved -> enrolled.
model Enrollment {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(120)
  email        String  @db.VarChar(255)
  mobile       String  @map("mobile_no") @db.VarChar(20)
  organization String  @db.VarChar(150)
  designation  String? @db.VarChar(120)
  country      String  @db.VarChar(100)

  // Professional background — every one of these is optional on the form.
  experience       String? @map("years_experience") @db.VarChar(40)
  domain           String? @map("technology_domain") @db.VarChar(120)
  existingCustomer String? @map("existing_customer") @db.VarChar(60)
  existingPartner  String? @map("existing_partner") @db.VarChar(60)

  /// Selected certification codes, comma-separated (e.g. "PAM 101, EPM 201").
  /// A join table would be the textbook shape, but these six codes are fixed
  /// copy in the data layer, never queried individually — a scalar keeps the
  /// lead readable in one row.
  certifications String @db.VarChar(255)

  status    String    @default("new") @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([email])
  @@map("certification_enrollment")
}
