# ============================================================================
# Template — copy to `.env` and fill in real values. Safe to commit.
#   cp .env.example .env
# ============================================================================

# ---- Database (MySQL, used by Prisma) --------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# ---- SMTP (Nodemailer) -----------------------------------------------------
# Gmail:      smtp.gmail.com : 587  (SMTP_PASS = Google App Password)
# Office 365: smtp.office365.com : 587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"           # "true" only for port 465
SMTP_USER=""
SMTP_PASS=""

# Where contact notifications are delivered (defaults to SMTP_USER if blank).
# Production: contact@iraje.com
CONTACT_TO=""
# From address on the notification email (defaults to SMTP_USER if blank).
# Must be the same mailbox as SMTP_USER — Gmail/O365 rewrite or reject a From
# address the authenticated account isn't allowed to send as.
# Production: inquiry@iraje.com
CONTACT_FROM=""

# ---- Sanity (structured content) -------------------------------------------
# Server-only. NEVER prefix these with NEXT_PUBLIC_ — the dataset is private and
# holds the exam question bank, so the tokens must not reach the browser.
# Tokens: Sanity manage → API → Tokens.
#   READ  token -> role "Viewer" (read-only), used by src/lib/sanity/client.js
#   WRITE token -> role "Editor" (read + write), used by src/lib/sanity/writeClient.js
# Two tokens on purpose: pages only ever hold the read-only one.
# Read at request time, so on Cloud Run set them as runtime env vars; the
# Docker build does not need them.
SANITY_PROJECT_ID="g6lrqpst"
SANITY_DATASET="production"
SANITY_API_VERSION="2026-02-01"
SANITY_API_READ_TOKEN=""
SANITY_API_WRITE_TOKEN=""
