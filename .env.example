# ============================================================================
# Template — copy to `.env` and fill in real values. Safe to commit.
#   cp .env.example .env
# ============================================================================

# ---- Database (MySQL, used by Prisma) --------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# ---- Site address -----------------------------------------------------------
# Used to build links inside emails (login page, admin review page).
# Production: https://www.iraje.com (no trailing slash)
APP_URL="http://localhost:3000"

# ---- Email (Microsoft Graph) -----------------------------------------------
# "console" prints emails in the terminal instead of sending (development).
# "graph" sends through Microsoft 365. Unset = graph in production, console otherwise.
MAIL_TRANSPORT="console"
# Mailbox every email is sent FROM. The Entra app is only allowed to send as this one.
MAIL_FROM="inquiry@iraje.com"
# Team inbox that receives contact-form and certification-request notifications.
CONTACT_TO="contact@iraje.com"
# From the Entra ID app registration "Iraje Website Mailer" (IT admin provides these).
# GRAPH_CLIENT_SECRET is a secret: on Cloud Run keep it in Secret Manager.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# ---- Sanity (structured content) -------------------------------------------
# Server-only. NEVER prefix these with NEXT_PUBLIC_ — the dataset is private and
# holds the exam question bank, so the tokens must not reach the browser.
# Tokens: Sanity manage → API → Tokens.
#   READ  token -> role "Viewer" (read-only), used by src/lib/sanity/client.js
#   WRITE token -> role "Editor" (read + write), used by src/lib/sanity/writeClient.js
# Two tokens on purpose: pages only ever hold the read-only one.
# Read at request time, so on Cloud Run set them as runtime env vars; the
# Docker build does not need them.
SANITY_PROJECT_ID="g6lrqpst"
SANITY_DATASET="production"
SANITY_API_VERSION="2026-02-01"
SANITY_API_READ_TOKEN=""
SANITY_API_WRITE_TOKEN=""
